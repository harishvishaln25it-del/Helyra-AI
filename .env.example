# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# HELYRA ENTERPRISE SECURITY ENVIRONMENT CONFIGURATION
# ==============================================================================

# SESSION_SECRET: 32+ byte cryptographic secret for session token HMAC and signature verification
SESSION_SECRET=""

# AUTH_SECRET: Master key for authentication token hashing and tamper protection
AUTH_SECRET=""

# ENCRYPTION_KEY: 256-bit AES-GCM master encryption key for sensitive at-rest data (e.g. 2FA secrets)
ENCRYPTION_KEY=""

# ARGON2 CONFIGURATION (RFC 9106 recommended parameters)
ARGON2_TIME_COST="3"
ARGON2_MEMORY_COST="65536"
ARGON2_PARALLELISM="4"

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Neon / Local Docker)
# ==============================================================================
# Connection-pooled connection string (Neon pooled endpoint or local PostgreSQL)
DATABASE_URL="postgresql://helyra_user:helyra_secure_password_2026@localhost:5432/helyra_db?schema=public&connection_limit=10&pool_timeout=20"

# Direct database connection string for running migrations (Neon direct endpoint or same as DATABASE_URL for local)
DIRECT_URL="postgresql://helyra_user:helyra_secure_password_2026@localhost:5432/helyra_db?schema=public"

# ==============================================================================
# OBJECT STORAGE FOR MEDICAL DOCUMENTS
# ==============================================================================
STORAGE_BUCKET="helyra-medical-docs"
STORAGE_PROVIDER="local" # "local" | "gcs" | "s3"
STORAGE_LOCAL_DIR="./storage"
STORAGE_ENCRYPTION_KEY="" # 256-bit AES-GCM key for at-rest file encryption
