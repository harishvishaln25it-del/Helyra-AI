generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL_DEVICES
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  PASSKEY_REGISTERED
  PASSKEY_REMOVED
  SESSION_REVOKED
  ACCOUNT_DELETED
  BRUTE_FORCE_LOCKOUT
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  name                 String
  passwordHash         String                 @map("password_hash")
  phone                String?
  role                 String                 @default("family_admin")
  language             String                 @default("en")
  adaptivePreferences  Json?                  @map("adaptive_preferences")
  emailVerifiedAt      DateTime?              @map("email_verified_at")
  twoFactorEnabled     Boolean                @default(false) @map("two_factor_enabled")
  avatarUrl            String?                @map("avatar_url")
  failedLoginAttempts  Int                    @default(0) @map("failed_login_attempts")
  lockoutUntil         DateTime?              @map("lockout_until")
  passwordChangedAt    DateTime               @default(now()) @map("password_changed_at")
  familyCode           String?                @unique @map("family_code")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  sessions             Session[]
  totpSecret           TotpSecret?
  passkeys             Passkey[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  emailVerifTokens     EmailVerificationToken[]
  healthDailies        HealthDaily[]
  stepHourlies         StepHourly[]
  workouts             Workout[]
  medications          Medication[]
  documents            Document[]
  familyMemberships    FamilyMember[]
  permissionsGiven     SharingPermission[]    @relation("SharedByMe")
  permissionsReceived  SharingPermission[]    @relation("SharedWithMe")
  sosEvents            SosEvent[]
  pushTokens           PushToken[]
  aiReports            AiReport[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  deviceInfo String?  @map("device_info")
  ip         String?
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model TotpSecret {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  encryptedSecret  String   @map("encrypted_secret")
  backupCodeHashes String[] @map("backup_code_hashes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceName   String?  @map("device_name")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  event     AuditEventType
  ip        String?
  device    String?
  userAgent String?        @map("user_agent")
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model HealthDaily {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  date          String
  steps         Int      @default(0)
  distance      Float    @default(0)
  activeMinutes Int      @default(0) @map("active_minutes")
  waterLiters   Float    @default(0) @map("water_liters")
  sleepHours    Float    @default(0) @map("sleep_hours")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("health_dailies")
}

model StepHourly {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String
  hour      Int
  steps     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, hour])
  @@index([userId, date])
  @@map("step_hourlies")
}

model Workout {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  steps     Int       @default(0)
  distanceM Float     @default(0) @map("distance_m")
  route     Json?
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workouts")
}

model Medication {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  name          String
  dosage        String
  scheduleTimes String[]        @map("schedule_times")
  notes         String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          MedicationLog[]

  @@index([userId])
  @@map("medications")
}

model MedicationLog {
  id           String     @id @default(uuid())
  medicationId String     @map("medication_id")
  scheduledFor DateTime   @map("scheduled_for")
  takenAt      DateTime?  @map("taken_at")
  status       String     @default("pending")
  createdAt    DateTime   @default(now()) @map("created_at")

  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId])
  @@index([scheduledFor])
  @@map("medication_logs")
}

model Document {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String
  type          String
  storageKey    String   @map("storage_key")
  extractedJson Json?    @map("extracted_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model Family {
  id         String         @id @default(uuid())
  name       String
  ownerId    String         @map("owner_id")
  inviteCode String         @unique @map("invite_code")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  members    FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id        String   @id @default(uuid())
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model SharingPermission {
  id                      String   @id @default(uuid())
  ownerUserId             String   @map("owner_user_id")
  viewerUserId            String   @map("viewer_user_id")
  shareActivity           Boolean  @default(true) @map("share_activity")
  shareExercise           Boolean  @default(true) @map("share_exercise")
  shareMedicationStatus   Boolean  @default(true) @map("share_medication_status")
  shareWater              Boolean  @default(true) @map("share_water")
  shareDetailedDocuments  Boolean  @default(false) @map("share_detailed_documents")
  sharePrivateMedicalInfo Boolean  @default(false) @map("share_private_medical_info")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  owner                   User     @relation("SharedByMe", fields: [ownerUserId], references: [id], onDelete: Cascade)
  viewer                  User     @relation("SharedWithMe", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, viewerUserId])
  @@index([ownerUserId])
  @@index([viewerUserId])
  @@map("sharing_permissions")
}

model SosEvent {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  triggerMethod   String   @map("trigger_method")
  lat             Float?
  lng             Float?
  status          String   @default("triggered")
  notifiedMembers Json?    @map("notified_members")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sos_events")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model AiReport {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  period    String
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_reports")
}
